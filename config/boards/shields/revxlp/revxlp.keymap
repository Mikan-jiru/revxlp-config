
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        test_layer {
            display-name = "TEST";
            bindings = <
                &kp ESC    &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y      &kp U       &kp I       &kp O       &kp P       &kp BKSP

                &kp TAB    &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H      &kp J       &kp K       &kp L       &kp SEMI    &kp RET

                &kp LSHFT  &kp Z       &kp X       &kp C       &kp V       &kp B
                &kp N      &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT

                           &kp LCTRL   &kp LALT    &kp SPACE   &kp RET     &kp RALT    &kp RCTRL
            >;
        };
    };
};
